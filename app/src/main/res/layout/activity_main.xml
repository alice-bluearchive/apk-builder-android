<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#252526"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back_to_list"
            android:textColor="#FFB300"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvProjectName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Project"
            android:textColor="#DDDDDD"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lang_toggle"
            android:textColor="#CCCCCC"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 包名 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pkg_label"
                android:textColor="#AAAAAA" />
            <EditText
                android:id="@+id/etPackage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2D2D2D"
                android:padding="12dp"
                android:textColor="#DDDDDD"
                android:hint="@string/pkg_hint"
                android:inputType="text" />

            <!-- 应用名 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/name_label"
                android:textColor="#AAAAAA" />
            <EditText
                android:id="@+id/etAppName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2D2D2D"
                android:padding="12dp"
                android:textColor="#DDDDDD"
                android:hint="@string/name_hint"
                android:inputType="text" />

            <!-- 图标 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/icon_label"
                android:textColor="#AAAAAA" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <ImageView
                    android:id="@+id/ivIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="#2D2D2D"
                    android:scaleType="centerCrop" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/btn_pick_icon" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvIconName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/icon_none"
                android:textColor="#666666"
                android:textSize="12sp" />

            <!-- 权限 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/perm_label"
                android:textColor="#AAAAAA" />
            <CheckBox
                android:id="@+id/permInternet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INTERNET"
                android:textColor="#DDDDDD" />
            <CheckBox
                android:id="@+id/permStorage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="READ_EXTERNAL_STORAGE"
                android:textColor="#DDDDDD" />
            <CheckBox
                android:id="@+id/permCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CAMERA"
                android:textColor="#DDDDDD" />
            <CheckBox
                android:id="@+id/permLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACCESS_FINE_LOCATION"
                android:textColor="#DDDDDD" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>